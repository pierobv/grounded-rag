# Copie para .env e ajuste:  cp .env.example .env
# O .env é ignorado pelo Git; este arquivo de exemplo é versionado.

# Endereço da API do Ollama (obrigatório).
# No Mac: http://localhost:11434
# No PC via Tailscale: http://<nome-da-maquina-no-tailscale>:11434
OLLAMA_BASE_URL=http://localhost:11434

# Modelos (opcionais; estes são os padrões)
LLM_MODEL=qwen2.5:7b
DEV_LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=bge-m3

# Caminhos (opcionais)
DATA_DIR=data/public
PROCESSED_DIR=data/processed
CHROMA_DIR=.chroma

# Chunking (opcionais). Tamanho e sobreposição em palavras.
# Estratégia: fixed | structure
CHUNK_STRATEGY=structure
CHUNK_SIZE=200
CHUNK_OVERLAP=40
# Põe o caminho de títulos no início de cada trecho (contextual chunk headers)
CHUNK_HEADINGS=true

# Embeddings (opcionais). O bge-m3 não usa prefixos; para o nomic-embed-text use
# EMBED_DOC_PREFIX="search_document: " e EMBED_QUERY_PREFIX="search_query: ".
EMBED_DOC_PREFIX=
EMBED_QUERY_PREFIX=
EMBED_BATCH_SIZE=32

# Busca (opcionais). Modo: vector | bm25 | hybrid
RETRIEVAL_MODE=hybrid
TOP_K=5
# Candidatos por buscador antes da fusão/reranking, e constante k do RRF
CANDIDATES=20
RRF_K=60

# Reranking com cross-encoder (opcionais)
RERANK=true
# Alternativa rápida (só inglês): cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Geração (opcionais)
NUM_CTX=8192
TEMPERATURE=0
SEED=42
# Score mínimo do melhor trecho (com reranking) para chamar o LLM.
# Desligado por padrão; descomente para ativar (calibrar na avaliação).
# MIN_RERANK_SCORE=0.0

# Mensagem fixa quando os documentos não contêm a resposta
ABSTAIN_MESSAGE="Não encontrei essa informação nos documentos."
