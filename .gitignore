# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Testes e lint
.pytest_cache/
.ruff_cache/

# Segredos e configuração local (use .env.example como modelo)
.env

# Material privado do mestrado: NUNCA versionar
data/private/

# Corpus baixado por scripts/fetch_corpus.py (só o MANIFEST.json é versionado)
data/public/owasp/*.md

# Trechos gerados por `grounded-rag ingest`
data/processed/

# Índice vetorial gerado localmente (reconstruível com `grounded-rag ingest`)
.chroma/

# macOS
.DS_Store

# Candidatos gerados para o dataset (revisados antes de entrar em evals/dataset.jsonl)
evals/candidates.jsonl

# Progresso parcial da avaliação (permite retomar uma rodada interrompida)
evals/results/.checkpoints/

# Material pessoal de estudo (não versionado)
docs/estudo/
